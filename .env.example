# Copy to .env.local for local development, or add these in Vercel Project Settings > Environment Variables
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Supabase is prepared as a database schema in supabase/schema.sql.
# The current frontend demo stores sample data in the browser (localStorage).
# Add Supabase project URL/anon key only after implementing authenticated data access.
SUPABASE_URL=
SUPABASE_ANON_KEY=
